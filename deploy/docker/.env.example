# 复制为 .env（与 compose.yaml 同目录）并修改。没有 .env 时 compose 使用默认值（只适合本机试用）。

# 浏览器访问站点的地址、BT 客户端访问 tracker 的地址（首次启动时写入 ./data/pt/site.toml）
PT_BASE_URL=http://localhost:31251
PT_TRACKER_URL=http://localhost:31252

# 宿主机端口
PT_HTTP_PORT=31251
PT_TRACKER_PORT=31252

# 密码与密钥：openssl rand -hex 24 生成。首次启动后不要再改（已写入数据库与 site.toml）
POSTGRES_PASSWORD=change-me-postgres
PT_DB_ADMIN_PASSWORD=change-me-admin
PT_DB_GATEWAY_PASSWORD=change-me-gateway
PT_MEILI_KEY=change-me-meili-master-key-0123456789

# 镜像（默认 latest = 最新发布版本；可固定为 ghcr.io/imythu/pt-studio:0.1.0）
# PT_IMAGE=ghcr.io/imythu/pt-studio:latest

# tracker 在反向代理之后时设为 true
# PT_TRUST_FORWARDED=false
