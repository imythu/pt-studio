{
  "schema": 1,
  "defaults": { "window_days": 90, "half_life_days": 14, "hits_fn": "log2", "hits_cap": 4, "max_evidence": 2000 },
  "thresholds": { "low": 10, "watch": 30, "case": 60, "critical": 80, "transfer_block": 60 },
  "rules": [
    { "type": "evidence", "id": "speed_medium", "mode": "enforce",
      "match": { "kinds": ["speed_exceeded"], "where": [{ "field": "severity", "op": "eq", "value": "medium" }] },
      "weight": 8, "per_torrent_cap": 16, "cap": 24, "tags": ["upload_fraud"],
      "context_mult": [{ "when": [{ "field": "ctx.is_seedbox", "op": "eq", "value": true }], "mult": 0.5 }] },
    { "type": "evidence", "id": "speed_high", "mode": "enforce",
      "match": { "kinds": ["speed_exceeded"], "severity_gte": "high" },
      "weight": 20, "severity_mult": { "high": 1 }, "per_torrent_cap": 30, "cap": 50, "tags": ["upload_fraud"],
      "context_mult": [{ "when": [{ "field": "ctx.is_seedbox", "op": "eq", "value": true }], "mult": 0.5 }] },
    { "type": "evidence", "id": "speed_extreme", "mode": "enforce",
      "match": { "kinds": ["speed_exceeded"], "where": [
        { "field": "details.speed_bps", "op": "gte", "value": { "ref": "details.limit_bps", "mul": 5 } },
        { "field": "details.bytes", "op": "gte", "value": 10737418240 } ] },
      "weight": 60, "severity_mult": { "low": 1, "medium": 1, "high": 1 }, "hits_fn": "none", "cap": 60,
      "tags": ["upload_fraud", "conclusive"] },
    { "type": "evidence", "id": "cross_check", "mode": "enforce",
      "match": { "kinds": ["cross_check_mismatch"] },
      "weight": 6, "per_torrent_cap": 12, "cap": 30, "tags": ["upload_fraud"] },
    { "type": "aggregate", "id": "cross_swarm", "mode": "enforce",
      "match": { "kinds": ["cross_check_mismatch"] }, "window_days": 7, "measure": "distinct_torrents",
      "steps": [{ "gte": 3, "score": 25 }, { "gte": 6, "score": 45 }], "tags": ["upload_fraud"] },
    { "type": "evidence", "id": "no_peer", "mode": "enforce",
      "match": { "kinds": ["peer_not_in_swarm"] },
      "weight": 4, "severity_mult": { "low": 0.75, "medium": 2.5 }, "per_torrent_cap": 10, "cap": 30, "tags": ["upload_fraud"] },
    { "type": "evidence", "id": "counter_jump", "mode": "enforce",
      "match": { "kinds": ["counter_jump"], "where": [{ "field": "details.kind", "op": "in",
                 "value": ["delta_exceeds_size", "left_exceeds_size", "out_of_range", "started_nonzero"] }] },
      "weight": 10, "per_torrent_cap": 15, "cap": 30, "tags": ["upload_fraud"] },
    { "type": "evidence", "id": "baseline_reset", "mode": "enforce",
      "match": { "kinds": ["counter_jump"], "where": [{ "field": "details.kind", "op": "eq", "value": "baseline_reset_nonstart" }] },
      "weight": 1, "cap": 5, "tags": ["client_anomaly"] },
    { "type": "evidence", "id": "negative_delta", "mode": "enforce",
      "match": { "kinds": ["negative_delta"] }, "weight": 2, "cap": 8, "tags": ["client_anomaly"] },
    { "type": "evidence", "id": "client_spoof", "mode": "enforce",
      "match": { "kinds": ["client_not_allowed"], "where": [{ "field": "details.kind", "op": "eq", "value": "fingerprint_mismatch" }] },
      "weight": 25, "hits_fn": "none", "cap": 40, "tags": ["client_spoof"] },
    { "type": "evidence", "id": "client_changed", "mode": "enforce",
      "match": { "kinds": ["client_not_allowed"], "where": [{ "field": "details.kind", "op": "eq", "value": "fingerprint_changed" }] },
      "weight": 8, "cap": 16, "tags": ["client_anomaly"] },
    { "type": "evidence", "id": "daily_spike", "mode": "enforce",
      "match": { "kinds": ["anticheat.daily_upload_spike"] }, "weight": 12, "cap": 30, "half_life_days": 30, "tags": ["upload_fraud"] },
    { "type": "evidence", "id": "shared_ip", "mode": "shadow",
      "match": { "kinds": ["anticheat.shared_ip_counterparty"] }, "weight": 20, "cap": 40, "tags": ["collusion"] },
    { "type": "multiplier", "id": "corroboration", "mode": "enforce",
      "when": [{ "measure": { "fn": "distinct_kinds", "window_days": 14, "match": { "kinds": [
        "speed_exceeded", "cross_check_mismatch", "peer_not_in_swarm", "counter_jump", "client_not_allowed", "anticheat.daily_upload_spike"] } },
        "op": "gte", "value": 3 }],
      "factor": 1.3, "applies_to_tags": ["upload_fraud", "client_spoof"] },
    { "type": "multiplier", "id": "new_account", "mode": "enforce",
      "when": [{ "field": "ctx.account_age_days", "op": "lt", "value": 30 }], "factor": 1.2, "applies_to_tags": ["upload_fraud"] },
    { "type": "multiplier", "id": "recidivism", "mode": "enforce",
      "when": [{ "field": "ctx.confirmed_cases_365d", "op": "gte", "value": 1 }], "factor": 1.5, "applies_to_tags": [] }
  ],
  "policies": [
    { "id": "conclusive_freeze", "when": { "rules_any": ["speed_extreme"] },
      "actions": [{ "kind": "freeze_traffic", "days": 7 }, { "kind": "lock_wallet" }], "auto": true },
    { "id": "critical_suggest", "when": { "band_gte": "critical" },
      "actions": [{ "kind": "freeze_traffic", "days": 14 }, { "kind": "adjust_traffic" }], "auto": false },
    { "id": "high_suggest", "when": { "band_gte": "high" }, "actions": [{ "kind": "warn", "days": 14 }], "auto": false }
  ]
}
